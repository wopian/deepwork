{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deepwork",
  "version": "0.1.0",
  "identifier": "dev.wopian.deepwork",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Deepwork \u2014 Mine Company",
        "width": 1440,
        "height": 940,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}