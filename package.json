{
  "name": "untitled-mine-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "dev": "bun --bun node_modules/vite/bin/vite.js",
    "build": "bun run typecheck && bun --bun node_modules/vite/bin/vite.js build",
    "typecheck": "bun --bun scripts/typecheck.cjs",
    "test": "bun test",
    "tauri": "bun --bun node_modules/@tauri-apps/cli/tauri.js",
    "check:runtime": "bun scripts/check-runtime.ts",
    "test:browser": "bun scripts/browser-check.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "pixi.js": "^8.13.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/bun": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "playwright-core": "1.55.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vue-tsc": "3.0.8"
  }
}
